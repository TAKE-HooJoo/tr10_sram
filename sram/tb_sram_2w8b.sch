C {devices/code_shown.sym} 2360 -460 0 0 {name=SPICE only_toplevel=false value="
.tran 10p 100n

* ============================================================
* ColMax 2w8b SRAM Read Measurement
* Observe: bit1 and bit7
* ============================================================

* WL 50% crossing
.meas tran t_wl0_rise WHEN v(WL0)=2.5 RISE=2
.meas tran t_wl1_rise WHEN v(WL1)=2.5 RISE=1

* BL differential at WL0 +0.5ns
.meas tran dvbl0_05 FIND par('abs(v(BL0)-v(BLB0))') AT=47.781n
.meas tran dvbl7_05 FIND par('abs(v(BL7)-v(BLB7))') AT=47.781n

* BL differential at WL0 +1.0ns
.meas tran dvbl0_10 FIND par('abs(v(BL0)-v(BLB0))') AT=48.281n
.meas tran dvbl7_10 FIND par('abs(v(BL7)-v(BLB7))') AT=48.281n

* Time when BL differential reaches 1.0V
.meas tran t_dvbl0_1v WHEN par('abs(v(BL0)-v(BLB0))')=1.0 RISE=1 TD=47n
.meas tran t_dvbl7_1v WHEN par('abs(v(BL7)-v(BLB7))')=1.0 RISE=1 TD=47n

* Delay from WL0 50% to 1.0V BL differential
.meas tran td_bl0 PARAM='t_dvbl0_1v-t_wl0_rise'
.meas tran td_bl7 PARAM='t_dvbl7_1v-t_wl0_rise'

.control
run
plot v(pcb) v(eqen)+6
plot v(wl0) v(wl1)+6
plot v(dout0) v(dout7)+6
plot v(bl0) v(blb0)
plot v(bl7) v(blb7)


.endc
"}
