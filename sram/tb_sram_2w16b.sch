C {devices/code.sym} 2380 -740 0 0 {name=TR-1um_MODELS
only_toplevel=true
format="tcleval( @value )"
value=".include $::LIB/ip62_models"
spice_ignore=false}
C {devices/code_shown.sym} 2360 -460 0 0 {name=SPICE only_toplevel=false value="
.tran 10p 100n

* ============================================================
* ColMax 2w16b SRAM Read Measurement
* Observe: bit0 and bit15
* ============================================================

* WL 50% crossing
.meas tran t_wl0_rise WHEN v(WL0)=2.5 RISE=2
.meas tran t_wl1_rise WHEN v(WL1)=2.5 RISE=1

* BL differential around WL0 +0.5ns
.meas tran dvbl0_05  FIND par('abs(v(BL0)-v(BLB0))')   AT=49.35n
.meas tran dvbl15_05 FIND par('abs(v(BL15)-v(BLB15))') AT=49.35n

* BL differential around WL0 +1.0ns
.meas tran dvbl0_10  FIND par('abs(v(BL0)-v(BLB0))')   AT=49.85n
.meas tran dvbl15_10 FIND par('abs(v(BL15)-v(BLB15))') AT=49.85n

* First 1V differential AFTER WL0 has started rising
.meas tran t_dvbl0_1v  WHEN par('abs(v(BL0)-v(BLB0))')=1.0 RISE=1 TD=48.85n
.meas tran t_dvbl15_1v WHEN par('abs(v(BL15)-v(BLB15))')=1.0 RISE=1 TD=48.85n

* Delay
.meas tran td_bl0  PARAM='t_dvbl0_1v-t_wl0_rise'
.meas tran td_bl15 PARAM='t_dvbl15_1v-t_wl0_rise'

.control
run

plot v(pcb) v(eqen)+6
plot v(wl0) v(wl1)+6
plot v(dout0) v(dout15)+6
plot v(bl0) v(blb0)
plot v(bl15) v(blb15)

.endc
"}
