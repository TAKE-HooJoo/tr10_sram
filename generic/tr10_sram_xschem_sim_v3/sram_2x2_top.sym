v {xschem version=3.4.8 file_version=1.2}
K {type=primitive
format="X@name @pinlist SRAM2X2"
template="name=SRAM"}
V {}
S {}
E {}
B 4 0 -110 260 110 {fill=false}
B 5 -10 -90 10 -70 {name=A0 dir=in pinnumber=1}
B 5 -10 -50 10 -30 {name=CE dir=in pinnumber=2}
B 5 -10 -10 10 10 {name=WE dir=in pinnumber=3}
B 5 -10 30 10 50 {name=DIN0 dir=in pinnumber=4}
B 5 -10 70 10 90 {name=DIN1 dir=in pinnumber=5}
B 5 250 -50 270 -30 {name=DOUT0 dir=out pinnumber=6}
B 5 250 30 270 50 {name=DOUT1 dir=out pinnumber=7}
B 5 90 -120 110 -100 {name=VDD dir=inout pinnumber=8}
B 5 150 100 170 120 {name=VSS dir=inout pinnumber=9}
T {2 word x 2 bit SRAM} 48 -18 0 0 0.34 0.34 {}
T {6T x 4 / single port} 62 20 0 0 0.23 0.23 {}
T {@name} 105 53 0 0 0.20 0.20 {}
