v {xschem version=3.4.8 file_version=1.2}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=X1"}
V {}
S {}
E {}
B 4 0 -80 190 80 {fill=false}
B 5 -10 -50 10 -30 {name=BL dir=inout pinnumber=1}
B 5 -10 0 10 20 {name=BLB dir=inout pinnumber=2}
B 5 -10 40 10 60 {name=CE dir=in pinnumber=3}
B 5 180 -10 200 10 {name=DOUT dir=out pinnumber=4}
B 5 55 -90 75 -70 {name=VDD dir=inout pinnumber=5}
B 5 110 70 130 90 {name=VSS dir=inout pinnumber=6}
T {PRECHARGE + READ} 20 -12 0 0 0.26 0.26 {}
T {@name} 72 27 0 0 0.20 0.20 {}
